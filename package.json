{
  "name": "t-assistant",
  "description": "A blazing fast, lightweight tool for i18n: manage translation keys with ease.",
  "license": "MIT",
  "version": "0.2.1",
  "repository": "github:asamofal/t-assistant",
  "keywords": [
    "translations",
    "i18n",
    "json",
    "locales",
    "lang",
    "language",
    "internalization"
  ],
  "author": {
    "name": "Anton Samofal",
    "email": "anton.smfl@gmail.com",
    "url": "https://github.com/asamofal"
  },
  "private": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "bin": {
    "t-assistant": "dist/index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsup src/index.ts --watch --format esm --dts",
    "build": "tsup src/index.ts --format esm --dts",
    "release": "npm run build && changeset publish",
    "test": "node --test --experimental-strip-types",
    "lint": "tsc && oxlint",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "glob": "^13.0.6"
  }
}
